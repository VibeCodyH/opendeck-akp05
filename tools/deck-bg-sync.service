[Unit]
Description=Sync stream deck video background to the KDE live wallpaper
# Start only once the Plasma/Wayland session env (WAYLAND_DISPLAY etc.) is imported,
# otherwise the daemon freezes a display-less env and every kscreen-doctor child aborts.
After=graphical-session.target
PartOf=graphical-session.target

[Service]
# Adjust the path to wherever you cloned this repo
ExecStart=/usr/bin/python3 %h/opendeck-akp05/tools/deck-bg daemon
Restart=always
RestartSec=10

[Install]
WantedBy=graphical-session.target
